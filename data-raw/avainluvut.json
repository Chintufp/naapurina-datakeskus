us."],"M162":["Työvoimaan kuuluvat 15-74-vuotiaat henkilöt, jotka vuoden viimeisellä viikolla olivat työllisiä tai työttömiä. Vuodesta 2005 lähtien työllisten alaikäraja on ollut 18 vuotta. Aikasarjan vertailukelpoisuuden vuoksi työttömyysaste on laskettu tässä 18-74-vuotiaasta väestöstä. Lähde: Työssäkäyntitilasto, Tilastokeskus."],"M152":["Tietyllä alueella työskentelevien henkilöiden lukumäärää voidaan käyttää kuvaamaan työpaikkojen lukumäärää tällä alueella. Jokaisen työllisen henkilön on tällöin ajateltu muodostavan yhden työpaikan. Osa-aikaistakin työtä tekevä henkilö muodostaa laskennallisesti yhden työpaikan. Työsuhteet voivat olla luonteeltaan myös tilapäisiä ja lyhytaikaisia. Lähde: Työssäkäyntitilasto, Tilastokeskus"]},"unit":{"M411":{"base":"?","decimals":0},"M44":{"base":"?","decimals":0},"M137":{"base":"?","decimals":0},"M162":{"base":"prosenttia","decimals":1},"M152":{"base":"?","decimals":0}}},"extension":{"elimination":false,"show":"value"}}},"extension":{"px":{"tableid":"142h_ka_vi_2026","decimals":0,"official-statistics":false,"aggregallowed":true,"language":"fi","contents":"Kuntien avainluvut","description":"Kuntien avainluvut","descriptiondefault":false,"heading":["Tiedot"],"stub":["Alue"],"matrix":"142h_ka_vi_2026","subject-code":"2023","subject-area":"2023"},"contact":[{"raw":"Tilastokeskus"}]},"value":[5652881,2860961,2423433,11.7,2417365,16429,8019,6917,10.7,4451,8982,4023,3320,7.9,3296,2384,1083,942,9.2,678,10634,5139,3927,12,3833,7841,3990,2785,11.8,2108,4677,2101,2167,7.6,1273,3937,1837,1806,7.3,1139,430,222,211,2.3,147,961,448,434,5.4,249,1273,670,437,12.4,362,1769,831,772,10.2,642,325716,148231,151301,10.2,138103,11005,5519,4691,7.6,3951,8920,4082,3851,7.6,3757,2267,1065,941,5.6,853,2625,1164,1291,3.7,911,16307,9248,5983,13.7,7395,512,239,229,2.6,201,512,239,235,4.5,118,6441,3090,2431,12.3,2615,6298,2868,2420,10.7,2511,912,487,327,12.1,220,975,475,374,9,325,19113,10246,7325,14.3,6143,1644,735,810,4.8,371,4436,2298,1633,12.8,1280,7620,41